{#
/**
 * @file
 * The partner logos row of the footer (block taxanotes_front_footer_logos).
 *
 * Available variables:
 * - logos: a list of logos, each with src (the image URL), alt, url (the
 *   link, may be empty) and class (a class for the item, may be empty; the
 *   Taxanotes credit carries taxanotes-footer-logos__credit).
 */
#}
<ul class="taxanotes-footer-logos">
  {% for logo in logos %}
    <li{% if logo.class %} class="{{ logo.class }}"{% endif %}>
      {% if logo.url %}<a href="{{ logo.url }}" title="{{ logo.alt }}">{% endif %}<img src="{{ logo.src }}" alt="{{ logo.alt }}" loading="lazy">{% if logo.url %}</a>{% endif %}
    </li>
  {% endfor %}
</ul>
