<?php

/**
 * @file
 * Lazily loaded taxon tree (jqTree) for the taxon content type.
 */

/**
 * Implements hook_theme().
 */
function node_tree_theme($existing, $type, $theme, $path) {
  return [
    'node-tree-hierarchy-tree-block' => [
      'variables' => ['data' => NULL],
      'template' => 'node-tree-hierarchy-tree-block',
    ],
    'node-tree-content-display-block' => [
      'variables' => [],
      'template' => 'node-tree-content-display-block',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 */
function node_tree_preprocess_block(&$variables) {
  if (($variables['configuration']['label'] ?? '') === "NodeTreeBlock") {
    $variables['attributes']['id'] = 'node_tree';
  }
}
