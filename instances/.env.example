# Secrets and deployment values of one instance. Copy to instances/<slug>/.env
# (gitignored by **/.env) and fill in; scripts/new-instance.sh creates the file
# with a random HASH_SALT when it is missing. Database *names* are not secrets
# and live in instance.yml (drupal.database, source.database).

# Drupal hash salt: any long random string, e.g. `openssl rand -hex 32`.
HASH_SALT=

# The instance's own database server (ddev: the db container, user db/db).
DB_HOST=db
DB_PORT=3306
DB_USER=db
DB_PASSWORD=db

# Address automated site mail is sent from (system.site:mail).
SITE_MAIL=webmaster@example.com

# Password of the uid 1 account at install time. Leave empty to let drush
# generate one (it is printed once by site:install).
ADMIN_PASSWORD=

# Scratchpads (Drupal 7) source database for the taxanotes_import migrations.
# Leave MIGRATE_DB_USER empty for an instance without a D7 source: the script
# then writes no `migrate` connection and runs no migration.
MIGRATE_DB_HOST=scratchpads.mysql
MIGRATE_DB_PORT=3306
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=
